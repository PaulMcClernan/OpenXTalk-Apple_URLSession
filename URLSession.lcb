constant kNSDocumentDirectory is 9
constant kNSUserDomainMask is 1

-- Block and task retention
private variable mTask as optional ObjcObject
private variable mBlock as optional ObjcBlockPointer

-- Block handler type matching ^(NSURL *, NSURLResponse *, NSError *)
handler type DownloadCompletionBlock(in pLocation as ObjcId, in pResponse as ObjcId, in pError as ObjcId) returns nothing

public handler DownloadComplete(in pLocation as ObjcId, in pResponse as ObjcId, in pError as ObjcId) returns nothing
   if pError is not nothing then
      variable tErrorDesc as ObjcId
      unsafe
         log "called back, error"

         put ObjC_NSErrorLocalizedDescription(pError) into tErrorDesc
      post "urlDownloadFailed" to sTarget with [tErrorDesc] --  'my script object' is NOT allowed for Library modules
      return
     end unsafe
   end if
   log "called back, no error"
/*
   if not ObjC_NSObjectIsKindOfClass(pResponse, ObjC_NSHTTPURLResponseClass()) then
      post "urlDownloadFailed" to sTarget with ["Unexpected response type"]
      return
   end if

   variable tStatus as String
   put ObjC_NSHTTPURLResponseStatusCode(pResponse) into tStatus

   if tStatus < 200 or tStatus >= 300 then
      post "urlDownloadFailed" to sTarget with ["HTTP status" && tStatus]
      return
   end if

   variable tFileManager as ObjcId
   put ObjC_NSFileManagerDefaultFileManager() into tFileManager
   variable tDocsURL as ObjcId
   put ObjC_NSArrayFirstObject( ObjC_NSFileManagerURLsForDirectoryInDomains(tFileManager, kNSDocumentDirectory, kNSUserDomainMask) ) into tDocsURL
   variable tSavedURL as ObjcId
   put ObjC_NSURLByAppendingPathComponent(tDocsURL, ObjC_NSURLLastPathComponent(pLocation)) into tSavedURL

   if ObjC_NSFileManagerFileExistsAtPath(tFileManager, ObjC_NSURLPath(tSavedURL)) then
      ObjC_NSFileManagerRemoveItemAtURL(tFileManager, tSavedURL, nothing)
   end if
   ObjC_NSFileManagerMoveItemAtURL(tFileManager, pLocation, tSavedURL, nothing)
   variable tSavedPath as String
   put ObjC_NSStringUTF8String(ObjC_NSURLPath(tSavedURL)) into tSavedPath
   */
   -- post "urlDownloadFinished"  to sTarget with [tSavedPath]
   post "urlDownloadTaskEnded" to sTarget
end handler

variable sDownloadCompleteCallbackPtr as optional ObjcBlockPointer
private variable sTarget as ScriptObject

public handler DownloadFileFromURL(in pSavePath as String, in pURL as String) returns nothing
   variable tURL as ObjcId
   variable tState as CUint
   variable tNSURLSessionTaskPriority as NaturalFloat
   variable tExpectedBytes as Number
   variable tBytesReceived as Number

   put the caller into sTarget
   log sTarget
   log pURL
   CreateObjcBlockPointerFromHandler( DownloadComplete , sDownloadCompleteCallbackPtr)
   log sDownloadCompleteCallbackPtr
   unsafe
      put ObjC_NSURLSessionDownloadTaskWithURL( ObjC_NSURLSessionSharedSession(), ObjC_NSURLWithString( StringToNSString(pURL) ) ) into mTask
      -- put ObjC_NSURLSessionDownloadTaskWithURLCompletion( ObjC_NSURLSessionSharedSession(), ObjC_NSURLWithString( StringToNSString(pURL) ), sDownloadCompleteCallbackPtr ) into mTask
      LogNSObjectReflection(mTask)
   --      put ObjC_NSURLSessionTaskGetPriority(mTask) into tNSURLSessionTaskPriority
   --       log tNSURLSessionTaskPriority
     -- NSURLSessionTaskPriorityLow, NSURLSessionTaskPriorityHigh
     put ObjC_NSURLSessionTaskState(mTask) into tState
     log tState -- should be 1 meaning it's not doing anything yet
      /*   STATE Enum
      = 0, NSURLSessionTaskStateRunning The task is currently being serviced by the session
      = 1, NSURLSessionTaskStateSuspended task object is not doing anything yet or is paused
      = 2, NSURLSessionTaskStateCanceling The task has been told to cancel. The session will receive a URLSession:task:didCompleteWithError: message.
      = 3, NSURLSessionTaskStateCompleted The task has completed and the session will receive no more delegate notifications
      -- AVAILABLE macos(10.9), ios(7.0), watchos(2.0), tvos(9.0)
      */
      ObjC_NSURLSessionTaskResume(mTask)
      put ObjC_NSURLSessionTaskGetPriority(mTask) into tNSURLSessionTaskPriority
      log tNSURLSessionTaskPriority

      put ObjC_NSURLSessionTaskCountOfBytesExpectedToReceive(mTask) into tExpectedBytes
      put ObjC_NSURLSessionTaskCountOfBytesReceived(mTask) into tBytesReceived
      log [tBytesReceived, tExpectedBytes ]

      put ObjC_NSURLSessionTaskState(mTask) into tState
      log tState -- should be 0 for running

   end unsafe
end handler

----------------------  NSDistributedNotificationCenter
private foreign handler objC_NSDistributedNotificationCenterDefaultCenter() returns ObjcId binds to "objc:NSDistributedNotificationCenter.+defaultCenter"
private foreign handler objC_NSDistributedNotificationCenterPostNotificationNameObject(in defaultCenter as ObjcId, in notificationName as ObjcId, in notificationObject as ObjcId) returns nothing binds to "objc:NSDistributedNotificationCenter.-postNotificationName:object:"
public handler DownloadFileFinished(in pathToFile as String) returns nothing
	if (the operating system is "mac") then
		variable defaultCenter as ObjcId
		unsafe
			put objC_NSDistributedNotificationCenterDefaultCenter() into defaultCenter
			objC_NSDistributedNotificationCenterPostNotificationNameObject( defaultCenter, StringToNSString("com.apple.DownloadFileFinished"), StringToNSString(pathToFile))
		end unsafe
	end if
end handler

