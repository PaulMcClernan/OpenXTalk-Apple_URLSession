-- NSURL
foreign handler ObjC_NSURLWithString(in pString as ObjcId) returns ObjcId binds to "objc:NSURL.+URLWithString:"
foreign handler ObjC_NSURLLastPathComponent(in pURL as ObjcId) returns ObjcId binds to "objc:NSURL.-lastPathComponent"
foreign handler ObjC_NSURLByAppendingPathComponent(in pURL as ObjcId, in pComponent as ObjcId) returns ObjcId binds to "objc:NSURL.-URLByAppendingPathComponent:"
foreign handler ObjC_NSURLPath(in pURL as ObjcId) returns ObjcId binds to "objc:NSURL.-path"

-- NSURLSession
foreign handler ObjC_NSURLSessionSharedSession() returns ObjcId binds to "objc:NSURLSession.+sharedSession"
foreign handler ObjC_NSURLSessionDownloadTaskWithURL(in pSession as ObjcId, in pNSURL as ObjcId ) returns ObjcId binds to "objc:NSURLSession.-downloadTaskWithURL:"
foreign handler ObjC_NSURLSessionDownloadTaskWithURLCompletion(in pSession as ObjcId, in pNSURL as ObjcId, in pBlock as optional ObjcBlockPointer) returns ObjcId binds to "objc:NSURLSession.-downloadTaskWithURL:completionHandler:"
-- NSURLSessionTask
foreign handler ObjC_NSURLSessionTaskResume(in pTask as ObjcId) returns nothing binds to "objc:NSURLSessionTask.-resume"
foreign handler ObjC_NSURLSessionTaskSuspend(in pTask as ObjcId) returns nothing binds to "objc:NSURLSessionTask.-suspend"
foreign handler ObjC_NSURLSessionTaskCancel(in pTask as ObjcId) returns nothing binds to "objc:NSURLSessionTask.-cancel"

foreign handler ObjC_NSURLSessionTaskState(in pTask as ObjcId) returns CUint binds to "objc:NSURLSessionTask.state"
foreign handler ObjC_NSURLSessionTaskGetPriority(in pTask as ObjcId) returns NaturalFloat binds to "objc:NSURLSessionTask.priority"
-- The relative priority at which you’d like a host to handle the task, specified as a floating point value.
-- NSURLSessionTaskPriorityDefault = 0.5, highest priority value is 1.0

foreign handler ObjC_NSURLSessionTaskResponse(in pTask as ObjcId) returns ObjcId binds to "objc:NSURLSessionTask.reponse"
-- The server’s response to the currently active request.
foreign handler ObjC_NSURLSessionTaskProgress(in pTask as ObjcId) returns ObjcId binds to "objc:NSURLSessionTask.progress"
-- A representation of the overall task progress, a 'NSProgress' class object
foreign handler ObjC_NSURLSessionTaskError(in pTask as ObjcId) returns CUint binds to "objc:NSURLSessionTask.error"
foreign handler ObjC_NSURLSessionTaskCurrentRequest(in pTask as ObjcId) returns ObjcId binds to "objc:NSURLSessionTask.currentRequest"

/*
currentRequest - The URL request object currently being handled by the task.
originalRequest - The original request object passed when the task was created.
taskDescription - An app-provided string value for the current task.
taskIdentifier - An identifier uniquely identifying the task within a given session.
error - An error object that indicates why the task failed.
*/

foreign handler ObjC_NSURLSessionTaskCountOfBytesExpectedToReceive(in pTask as ObjcId) returns Int64 binds to "objc:NSURLSessionTask.countOfBytesExpectedToReceive"
-- The number of bytes that the task expects to receive in the response body.
foreign handler ObjC_NSURLSessionTaskCountOfBytesReceived(in pTask as ObjcId) returns Int64 binds to "objc:NSURLSessionTask.countOfBytesReceived"
-- The number of bytes that the task has received from the server in the response body.
-- Sending TO DO:
-- countOfBytesExpectedToSend - The number of bytes that the task expects to send in the request body.
-- countOfBytesSent - The number of bytes that the task has sent to the server in the request body.
-- NSURLSessionTransferSizeUnknown - constant that indicates that total size of the transfer cannot be determined.

-- NSURLResponse -- protocol agnostic reponse obj
foreign handler ObjC_NSURLResponseSuggestedFilename(in pResponse as ObjcId) returns ObjcId binds to "objc:NSURLResponse.-suggestedFilename"

-- NSHTTPURLResponse -- the HTTP specific class obj
foreign handler ObjC_NSHTTPURLResponseClass() returns ObjcId binds to "objc:NSHTTPURLResponse.+class"
foreign handler ObjC_NSHTTPURLResponseStatusCode(in pResponse as ObjcId) returns CUint binds to "objc:NSHTTPURLResponse.-statusCode"

-- NSFileManager
foreign handler ObjC_NSFileManagerDefaultFileManager() returns ObjcId binds to "objc:NSFileManager.+defaultManager"
foreign handler ObjC_NSFileManagerURLsForDirectoryInDomains(in pManager as ObjcId, in pDirectory as ObjcId , in pDomains as String) returns ObjcId binds to "objc:NSFileManager.-URLsForDirectory:inDomains:"
foreign handler ObjC_NSFileManagerFileExistsAtPath(in pManager as ObjcId, in pPath as ObjcId) returns CBool binds to "objc:NSFileManager.-fileExistsAtPath:"
foreign handler ObjC_NSFileManagerRemoveItemAtURL(in pManager as ObjcId, in pURL as ObjcId, in pError as ObjcId) returns CBool binds to "objc:NSFileManager.-removeItemAtURL:error:"
foreign handler ObjC_NSFileManagerMoveItemAtURL(in pManager as ObjcId, in pSrc as ObjcId, in pDst as ObjcId, in pError as ObjcId) returns CBool binds to "objc:NSFileManager.-moveItemAtURL:toURL:error:"

-- NSArray
foreign handler ObjC_NSArrayFirstObject(in pArray as ObjcId) returns ObjcId binds to "objc:NSArray.-firstObject"
-- NSError
foreign handler ObjC_NSErrorLocalizedDescription(in pError as ObjcId) returns ObjcId binds to "objc:NSError.-localizedDescription"

constant kNSDocumentDirectory is 9
constant kNSUserDomainMask is 1

-- Block and task retention
private variable mTask as optional ObjcObject
private variable mBlock as optional ObjcBlockPointer

-- Block handler type matching ^(NSURL *, NSURLResponse *, NSError *)
-- BlockPointer, NSURL *location, NSURLResponse *response, NSError *error
public handler type DownloadCompletionBlock( in pContext as ObjcBlockPointer, in pLocation as optional ObjcId, in pResponse as ObjcId, in pError as optional ObjcId) returns nothing
public handler DownloadComplete( in pContext as ObjcBlockPointer, in pLocation as optional ObjcId, in pResponse as optional ObjcId, in pError as optional ObjcId) returns nothing
       if pError is not nothing then
         variable tErrorDesc as ObjcId
         variable tErrorStr as String
         unsafe
            put ObjC_NSErrorLocalizedDescription(pError) into tErrorDesc
            log "---- pErrorDesc:"
            put StringFromNSString( tErrorDesc) into tErrorStr
            log tErrorStr
            --  LogNSObjectReflection( tErrorDesc )

             log "---- pError:"
             LogNSObjectReflection(pError)
             post "urlDownloadFailed" to sTarget with [tErrorStr]
          end unsafe
         return
      end if
      -- log "called back, no error"
      /*
      -- if not ObjC_NSObjectIsKindOfClass(pResponse, ObjC_NSHTTPURLResponseClass()) then
         post "urlDownloadFailed" to sTarget with ["Unexpected response type"]
         return
      end if
      */
      log "--- pLocation:\n"
      LogNSObjectReflection(pLocation)
      log "\n"
      log "---- pRespons:\n"
      LogNSObjectReflection( pResponse )

      variable tStatus as CULong
      unsafe
        put ObjC_NSHTTPURLResponseStatusCode( pResponse ) into tStatus
      end unsafe
      if tStatus < 200 or tStatus >= 300 then
         post "urlDownloadFailed" to sTarget with ["HTTP status" && tStatus]
         return
      end if

      /*
      variable tFileManager as ObjcId
      put ObjC_NSFileManagerDefaultFileManager() into tFileManager
      variable tDocsURL as ObjcId
      put ObjC_NSArrayFirstObject( ObjC_NSFileManagerURLsForDirectoryInDomains(tFileManager, kNSDocumentDirectory, kNSUserDomainMask) ) into tDocsURL
      variable tSavedURL as ObjcId
      put ObjC_NSURLByAppendingPathComponent(tDocsURL, ObjC_NSURLLastPathComponent(pLocation)) into tSavedURL

      if ObjC_NSFileManagerFileExistsAtPath(tFileManager, ObjC_NSURLPath(tSavedURL)) then
         ObjC_NSFileManagerRemoveItemAtURL(tFileManager, tSavedURL, nothing)
      end if
      ObjC_NSFileManagerMoveItemAtURL(tFileManager, pLocation, tSavedURL, nothing)
      variable tSavedPath as String
      put ObjC_NSStringUTF8String(ObjC_NSURLPath(tSavedURL)) into tSavedPath

      -- post "urlDownloadFinished"  to sTarget with [tSavedPath]
      */

      post "urlDownloadTaskEnded" to sTarget
    -- end unsafe
end handler

variable sDownloadCompleteCallbackPtr as optional ObjcBlockPointer
private variable sTarget as ScriptObject
public handler DownloadFileFromURL(in pURL as String, in pSavePath as String ) returns nothing
   variable tURL as ObjcId
   variable tState as CUint
   variable tNSURLSessionTaskPriority as NaturalFloat
   variable tExpectedBytes as Int64
   variable tBytesReceived as Int64

   put the caller into sTarget
   log ["callback to",sTarget]
   log ["URL",pURL]
   if pURL is the empty string then
      log "no url param"
      return
   end if
   CreateObjcBlockPointerFromHandler( DownloadComplete , sDownloadCompleteCallbackPtr)
   unsafe
      -- put ObjC_NSURLSessionDownloadTaskWithURL( ObjC_NSURLSessionSharedSession(), ObjC_NSURLWithString( StringToNSString(pURL) ) ) into mTask
      put ObjC_NSURLSessionDownloadTaskWithURLCompletion( ObjC_NSURLSessionSharedSession(), ObjC_NSURLWithString( StringToNSString(pURL) ), sDownloadCompleteCallbackPtr ) into mTask
      LogNSObjectReflection(mTask)
      --      put ObjC_NSURLSessionTaskGetPriority(mTask) into tNSURLSessionTaskPriority
      --       log tNSURLSessionTaskPriority
     -- NSURLSessionTaskPriorityLow, NSURLSessionTaskPriorityHigh
    --  put ObjC_NSURLSessionTaskState(mTask) into tState
     -- log tState -- should be 1 meaning it's not doing anything yet
      /*   STATE Enum
      = 0, NSURLSessionTaskStateRunning The task is currently being serviced by the session
      = 1, NSURLSessionTaskStateSuspended task object is not doing anything yet or is paused
      = 2, NSURLSessionTaskStateCanceling The task has been told to cancel. The session will receive a URLSession:task:didCompleteWithError: message.
      = 3, NSURLSessionTaskStateCompleted The task has completed and the session will receive no more delegate notifications
      -- AVAILABLE macos(10.9), ios(7.0), watchos(2.0), tvos(9.0)
      */
      ObjC_NSURLSessionTaskResume(mTask)
      /*
      put ObjC_NSURLSessionTaskGetPriority(mTask) into tNSURLSessionTaskPriority
      log ["tNSURLSessionTaskPriority", tNSURLSessionTaskPriority]
      */
      put ObjC_NSURLSessionTaskCountOfBytesExpectedToReceive(mTask) into tExpectedBytes
      put ObjC_NSURLSessionTaskCountOfBytesReceived(mTask) into tBytesReceived
      log [ "Bytes expected",tExpectedBytes,"bytes recieved",tBytesReceived ]

      put ObjC_NSURLSessionTaskState(mTask) into tState
      log tState -- should be 0 for running
   end unsafe
end handler

public handler checkProgress() returns nothing
	if (the operating system is "mac") then
		variable tExpectedBytes as Int64
      variable tBytesReceived as Int64
      variable tState as optional Integer
      variable tResponseObj as optional ObjcId
      variable tProgressObj as optional ObjcId
      variable tNSStringObj as optional ObjcId
      variable tStr as optional String

      if mTask is not nothing then
		unsafe
         put ObjC_NSURLSessionTaskCountOfBytesExpectedToReceive(mTask) into tExpectedBytes
         put ObjC_NSURLSessionTaskCountOfBytesReceived(mTask) into tBytesReceived
         log [tBytesReceived, tExpectedBytes ]

         put ObjC_NSURLSessionTaskState(mTask) into tState
         log tState -- should be 0 for currently running task
         -- 3 means that the task finished but does NOT mean that data transfer was successful

         --  put ObjC_NSURLSessionTaskResponse(mTask) into tResponseObj -- NOPE -- Response obj only comes with delegate or block callback
         --  log tResponseObj
         -- put ObjC_NSURLResponseSuggestedFilename( tResponseObj ) into tNSStringObj
         -- put StringFromNSString( tNSStringObj ) into tStr
         -- log tStr
         -- currentRequest

         -- put ObjC_NSURLSessionTaskProgress(mTask) into tProgressObj -- NSProgess class obj -- works fine but not particularly useful info
         --  LogNSObjectReflection(tProgressObj)
		end unsafe
      end if
	end if
end handler

----------------------  NSDistributedNotificationCenter
private foreign handler objC_NSDistributedNotificationCenterDefaultCenter() returns ObjcId binds to "objc:NSDistributedNotificationCenter.+defaultCenter"
private foreign handler objC_NSDistributedNotificationCenterPostNotificationNameObject(in defaultCenter as ObjcId, in notificationName as ObjcId, in notificationObject as ObjcId) returns nothing binds to "objc:NSDistributedNotificationCenter.-postNotificationName:object:"
public handler DownloadFileFinished(in pathToFile as String) returns nothing
	if (the operating system is "mac") then
		variable defaultCenter as ObjcId
		unsafe
			put objC_NSDistributedNotificationCenterDefaultCenter() into defaultCenter
			objC_NSDistributedNotificationCenterPostNotificationNameObject( defaultCenter, StringToNSString("com.apple.DownloadFileFinished"), StringToNSString(pathToFile))
		end unsafe
	end if
end handler

