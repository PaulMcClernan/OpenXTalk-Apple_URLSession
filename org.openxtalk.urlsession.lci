import module org.openxtalk.urlsession
  use com.livecode.foreign
  use com.livecode.objc
  use com.livecode.engine
  use com.livecode.arithmetic
  use com.livecode.binary
  use com.livecode.list
  use com.livecode.logic
  use com.livecode.string
  use com.livecode.type
  use com.livecode.system
  handler type DownloadCompletionBlock(in pContext as Pointer, in pLocation as optional ObjcId, in pResponse as ObjcId, in pError as optional ObjcId) returns nothing
  handler DownloadComplete(in pContext as Pointer, in pLocation as optional ObjcId, in pResponse as optional ObjcId, in pError as optional ObjcId) returns nothing
  handler DownloadFileFromURL(in pURL as String, in pSavePath as String) returns nothing
  handler checkProgress() returns nothing
  handler DownloadFileFinished(in pathToFile as String) returns nothing
  foreign handler objC_NSObjectsGetClassDescriptionForClass(in pClasss as ObjcId) returns optional ObjcRetainedId
  handler LogNSObjectReflection(in pNSObj as optional ObjcId) returns optional any
  handler NSArrayToString(in pNSArray as ObjcObject) returns String
end module
